# ---------- 环境变量（含密钥，绝不入库）----------
.env
.env.local
.env.*.local
!.env.example
!server/.env.example
!server/.env.docker.example

# ---------- 依赖 ----------
node_modules/
*/node_modules/

# ---------- 运行时数据 ----------
server/uploads/
!server/uploads/.gitkeep
logs/
*.log
npm-debug.log*
pids/
*.pid

# ---------- 构建产物 ----------
dist/
build/
coverage/

# ---------- Docker 本地数据（若用 bind mount 而非具名卷）----------
docker/data/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- 微信开发者工具本地配置（含个人设置，不入库）----------
project.private.config.json
miniprogram/project.private.config.json

# ---------- 工具内部状态（本地记忆、校验截图等，不属于项目代码）----------
.workbuddy/
.codebuddy/
