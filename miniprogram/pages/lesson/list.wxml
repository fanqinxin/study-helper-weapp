<view class="page page--with-tabbar theme-{{theme}}">
  <nav-bar mode="title" title="课文同步学" />

  <view class="page__content">

    <!-- ============ 学科切换 ============ -->
    <view class="subjects">
      <view
        wx:for="{{subjects}}"
        wx:key="value"
        class="subject {{subject === item.value ? 'subject--active' : ''}} {{item.available ? '' : 'subject--empty'}}"
        hover-class="subject--hover"
        data-value="{{item.value}}"
        data-name="{{item.name}}"
        bindtap="onSubjectTap"
      >
        {{item.name}}
      </view>
    </view>

    <!-- ============ 页头 ============ -->
    <view class="head">
      <view class="head__left">
        <view class="head__sub" wx:if="{{textbook}}">
          {{textbook.grade}}年级 · {{textbook.name}}
        </view>
        <view class="head__sub" wx:else>还没有选择教材，先选一本正在用的课本</view>
      </view>
      <view class="head__switch" hover-class="head__switch--active" bindtap="onSwitchTextbook">
        切换教材
      </view>
    </view>

    <skeleton wx:if="{{loading}}" hero="{{true}}" rows="{{2}}" />

    <!-- ============ 未选教材 ============ -->
    <empty-state
      wx:elif="{{!textbook}}"
      icon="book"
      color="#FFC857"
      text="还没有选择教材"
      desc="选好你正在用的课本，就能同步练到对应的课文"
      action="去选教材"
      bind:action="onSwitchTextbook"
    />

    <!-- ============ 正常内容 ============ -->
    <block wx:else>

      <!-- 推荐下一课 -->
      <view class="next" wx:if="{{nextLesson}}">
        <view class="next__head">
          <view class="next__label">接着课本往下学</view>
          <view class="next__adjust" hover-class="next__adjust--active" bindtap="onOpenPicker">
            学到第几课？
          </view>
        </view>
        <view class="next__title">第{{nextLesson.seq}}课 · {{nextLesson.title}}</view>
        <view class="next__desc" wx:if="{{nextLesson.knowledgePoints.length}}">
          知识点：{{nextLesson.knowledgePoints[0]}}
        </view>

        <view class="next__btn" hover-class="next__btn--active" bindtap="onStartNext">
          <image class="next__btn-icon" src="{{iconPlay}}" mode="aspectFit" />
          <text>开始练习</text>
        </view>
      </view>

      <!-- 全部练完：仍要能调整进度 -->
      <view class="next next--done" wx:elif="{{textbook}}">
        <view class="next__head">
          <view class="next__label">本册课文都练完了</view>
          <view class="next__adjust" hover-class="next__adjust--active" bindtap="onOpenPicker">
            学到第几课？
          </view>
        </view>
        <view class="next__desc">想复习哪一课，进下面的列表点一下就行</view>
      </view>

      <!-- 全部课文 -->
      <view class="section" wx:for="{{groups}}" wx:for-item="group" wx:key="unit">
        <view class="section__title">{{group.unit}}</view>

        <view class="lessons">
          <view
            wx:for="{{group.list}}"
            wx:key="id"
            class="lesson {{item.current ? 'lesson--current' : ''}} {{item.passed ? 'lesson--passed' : ''}}"
            hover-class="lesson--active"
            data-id="{{item.id}}"
            bindtap="onLessonTap"
          >
            <view class="lesson__seq">{{item.seq}}</view>
            <view class="lesson__main">
              <view class="lesson__title">{{item.title}}</view>
              <view class="lesson__meta" wx:if="{{item.knowledgePoints.length}}">
                {{item.knowledgePoints[0]}}
              </view>
            </view>
            <view class="lesson__state" wx:if="{{item.passed}}">已学</view>
            <view class="lesson__state lesson__state--current" wx:elif="{{item.current}}">当前</view>
          </view>
        </view>
      </view>

    </block>

  </view>

  <!-- ============ 选择「当前学到哪一课」 ============ -->
  <view class="sheet-mask" wx:if="{{showPicker}}" bindtap="onClosePicker"></view>

  <view class="sheet" wx:if="{{showPicker}}">
    <view class="sheet__bar">
      <view class="sheet__title">你现在学到哪一课？</view>
      <view class="sheet__close" hover-class="sheet__close--active" bindtap="onClosePicker">关闭</view>
    </view>
    <view class="sheet__tip">选中的课会成为「当前」，它前面的课记为已学</view>

    <scroll-view class="sheet__body" scroll-y>
      <view class="sheet__group" wx:for="{{groups}}" wx:for-item="g" wx:key="unit">
        <view class="sheet__unit">{{g.unit}}</view>
        <view
          wx:for="{{g.list}}"
          wx:key="id"
          class="sheet__row {{item.current ? 'sheet__row--on' : ''}}"
          hover-class="sheet__row--hover"
          data-id="{{item.id}}"
          bindtap="onPickCurrent"
        >
          <view class="sheet__seq">第{{item.seq}}课</view>
          <view class="sheet__name">{{item.title}}</view>
          <view class="sheet__tag" wx:if="{{item.current}}">当前</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <tab-bar current="{{1}}" />
</view>
