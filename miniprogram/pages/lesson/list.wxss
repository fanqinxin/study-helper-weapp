/* ============ 课文列表 —— 设计稿 02 ============ */

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
  padding: var(--space-sm) 0 var(--space-xl);
}

.head__title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.head__sub {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}

.head__switch {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
  font-size: var(--fs-tiny);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.head__switch--active {
  opacity: 0.75;
}

/* ---------- 推荐下一课 ---------- */
.next {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 32rpx;
  border-radius: var(--radius-2xl);
  background: linear-gradient(150deg, #FFE0A8 0%, #FFC857 60%, #F5B93C 100%);
  box-shadow: 0 12rpx 32rpx rgba(224, 163, 46, 0.26);
}

.next__label {
  font-size: var(--fs-tiny);
  font-weight: 700;
  color: rgba(122, 83, 18, 0.85);
}

.next__title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-on-brand);
  line-height: 1.3;
}

.next__desc {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: rgba(55, 53, 47, 0.62);
}

.next__btn {
  margin-top: 26rpx;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: #37352F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.next__btn--active {
  opacity: 0.86;
}

.next__btn-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ---------- 课文分组 ---------- */
.section {
  margin-top: var(--space-2xl);
}

.section__title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

.lessons {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.lesson {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: 24rpx 26rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.lesson--active {
  opacity: 0.8;
}

/* 当前该学的一课：黄色描边突出 */
.lesson--current {
  border: 3rpx solid var(--brand);
}

.lesson__seq {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--brand-light);
  color: var(--brand-deep);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lesson--passed .lesson__seq {
  background: var(--grass-light);
  color: var(--grass);
}

.lesson--current .lesson__seq {
  background: var(--brand);
  color: var(--text-on-brand);
}

.lesson__main {
  flex: 1;
  min-width: 0;
}

.lesson__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson__meta {
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson__state {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  background: var(--grass-light);
  color: var(--grass);
}

.lesson__state--current {
  background: var(--coral-light);
  color: var(--coral);
}
