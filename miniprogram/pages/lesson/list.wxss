/* ============ 课文列表 —— 设计稿 02 ============ */

/* ---------- 学科切换 ---------- */
.subjects {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) 0 var(--space-md);
}

.subject {
  flex: 1;
  height: 76rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 3rpx solid transparent;
  color: var(--text-secondary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-soft);
  box-sizing: border-box;
}

.subject--hover {
  opacity: 0.85;
}

.subject--active {
  background: var(--brand);
  border-color: var(--brand-deep);
  color: var(--text-on-brand);
  font-weight: 700;
}

/* 该学科还没有教材：虚线弱化，点一下会引导去添加 */
.subject--empty {
  border: 3rpx dashed var(--border);
  color: var(--text-quaternary);
  box-shadow: none;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding: 0 0 var(--space-xl);
}

.head__title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.head__sub {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}

.head__switch {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
  font-size: var(--fs-tiny);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.head__switch--active {
  opacity: 0.75;
}

/* ---------- 推荐下一课 ---------- */
.next {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 32rpx;
  border-radius: var(--radius-2xl);
  background: linear-gradient(150deg, #FFE0A8 0%, #FFC857 60%, #F5B93C 100%);
  box-shadow: 0 12rpx 32rpx rgba(224, 163, 46, 0.26);
}

.next__label {
  font-size: var(--fs-tiny);
  font-weight: 700;
  color: rgba(122, 83, 18, 0.85);
}

.next__title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-on-brand);
  line-height: 1.3;
}

.next__desc {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: rgba(55, 53, 47, 0.62);
}

.next__btn {
  margin-top: 26rpx;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: #37352F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.next__btn--active {
  opacity: 0.86;
}

.next__btn-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ---------- 课文分组 ---------- */
.section {
  margin-top: var(--space-2xl);
}

.section__title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

.lessons {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.lesson {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: 24rpx 26rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.lesson--active {
  opacity: 0.8;
}

/* 当前该学的一课：黄色描边突出 */
.lesson--current {
  border: 3rpx solid var(--brand);
}

.lesson__seq {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--brand-light);
  color: var(--brand-deep);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lesson--passed .lesson__seq {
  background: var(--grass-light);
  color: var(--grass);
}

.lesson--current .lesson__seq {
  background: var(--brand);
  color: var(--text-on-brand);
}

.lesson__main {
  flex: 1;
  min-width: 0;
}

.lesson__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson__meta {
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson__state {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  background: var(--grass-light);
  color: var(--grass);
}

.lesson__state--current {
  background: var(--coral-light);
  color: var(--coral);
}

/* ---------- 推荐卡：调整当前课文 ---------- */
.next__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

.next__adjust {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.62);
  color: #7A5312;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.next__adjust--active {
  opacity: 0.7;
}

.next--done .next__title {
  font-size: 34rpx;
}

.next--done .next__desc {
  margin-top: 12rpx;
}

/* ---------- 底部选择面板 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 28, 24, 0.42);
  /* tab-bar 是 z-index:100，面板必须盖在它上面，否则底部会被挡住 */
  z-index: 190;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 191;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding: var(--space-lg) var(--space-xl) calc(var(--space-lg) + env(safe-area-inset-bottom));
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  background: var(--bg-card);
  box-shadow: 0 -12rpx 32rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}

.sheet__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet__title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-primary);
}

.sheet__close {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--text-secondary);
}

.sheet__close--active {
  opacity: 0.6;
}

.sheet__tip {
  margin-top: 8rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}

.sheet__body {
  margin-top: var(--space-md);
  max-height: 58vh;
}

.sheet__unit {
  margin: var(--space-md) 0 8rpx;
  font-size: var(--fs-tiny);
  font-weight: 700;
  color: var(--text-tertiary);
}

.sheet__row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: 22rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--bg-subtle);
  margin-bottom: 10rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.sheet__row--hover {
  opacity: 0.8;
}

.sheet__row--on {
  background: var(--brand-light);
  border-color: var(--brand);
}

.sheet__seq {
  flex-shrink: 0;
  font-size: var(--fs-tiny);
  font-weight: 600;
  color: var(--text-tertiary);
}

.sheet__name {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet__tag {
  flex-shrink: 0;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 19rpx;
  background: var(--coral-light);
  color: var(--coral);
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
