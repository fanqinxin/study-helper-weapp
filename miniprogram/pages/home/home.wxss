/* ============ 首页 —— 对应设计稿 01 ============ */

/* ---------- 问候区 ---------- */
.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
  padding: var(--space-sm) 0 var(--space-xl);
}

.hero__left {
  flex: 1;
  min-width: 0;
}

.hero__greeting {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.25;
}

.hero__sub {
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 今日任务卡 ---------- */
.task-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 32rpx;
  border-radius: var(--radius-2xl);
  background: linear-gradient(150deg, #FFD87A 0%, #FFC857 55%, #F5B93C 100%);
  box-shadow: 0 12rpx 32rpx rgba(224, 163, 46, 0.28);
  box-sizing: border-box;
}

/* 右上角高光，让卡片有绘本的柔和感 */
.task-card__glow {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.32);
  pointer-events: none;
}

.task-card__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-card__tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.62);
  font-size: var(--fs-tiny);
  font-weight: 700;
  color: #7A5312;
  line-height: 1;
  box-sizing: border-box;
}

.task-card__tag-icon {
  width: 26rpx;
  height: 26rpx;
}

.task-card__progress {
  font-size: var(--fs-tiny);
  font-weight: 700;
  color: rgba(55, 53, 47, 0.55);
}

.task-card__title {
  position: relative;
  margin-top: 26rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-on-brand);
  line-height: 1.3;
}

.task-card__desc {
  position: relative;
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: rgba(55, 53, 47, 0.62);
  line-height: 1.45;
}

.task-card__bar {
  position: relative;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.5);
}

.task-card__bar .progress__fill {
  background: #FFFFFF;
}

.task-card__btn {
  position: relative;
  margin-top: 26rpx;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: #37352F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.task-card__btn--active {
  opacity: 0.86;
}

.task-card__btn-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ---------- 数据概览 ---------- */
.stats {
  display: flex;
  align-items: center;
  margin-top: var(--space-lg);
  padding: 30rpx 0;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.stats__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats__num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.stats__unit {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  margin-left: 2rpx;
}

.stats__label {
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}

.stats__line {
  width: 1rpx;
  height: 52rpx;
  background: var(--divider);
}

/* ---------- 学习工具 ---------- */
.section {
  margin-top: var(--space-2xl);
}

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.section__title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-primary);
}

.tools {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}

.tool {
  width: calc((100% - var(--space-md)) / 2);
  padding: 26rpx 24rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.tool--active {
  opacity: 0.8;
}

.tool__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool__icon-img {
  width: 44rpx;
  height: 44rpx;
}

.tool__name {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.tool__desc {
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
