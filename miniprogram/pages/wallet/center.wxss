/* ============ 额度中心 —— 设计稿 20 ============ */

/* ---------- 余额卡 ---------- */
.balance {
  padding: 34rpx 30rpx 30rpx;
  border-radius: var(--radius-2xl);
  background: linear-gradient(150deg, #FFD87A 0%, #FFC857 55%, #F5B93C 100%);
  box-shadow: 0 12rpx 32rpx rgba(224, 163, 46, 0.26);
  margin-top: var(--space-sm);
}

.balance__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.balance__label {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: rgba(55, 53, 47, 0.68);
}

.balance__badge {
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #7A5312;
  font-size: var(--fs-tiny);
  font-weight: 700;
  display: flex;
  align-items: center;
}

.balance__num {
  margin-top: 16rpx;
  font-size: 96rpx;
  font-weight: 700;
  color: var(--text-on-brand);
  line-height: 1;
}

.balance__unit {
  font-size: 32rpx;
  color: rgba(55, 53, 47, 0.55);
  margin-left: 8rpx;
}

.balance__detail {
  display: flex;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
}

.balance__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.balance__cell-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-on-brand);
  line-height: 1;
}

.balance__cell-label {
  font-size: 20rpx;
  color: rgba(55, 53, 47, 0.6);
}

.balance__reset {
  margin-top: 24rpx;
  font-size: var(--fs-tiny);
  color: rgba(55, 53, 47, 0.62);
  line-height: 1.5;
}

/* ---------- 规则说明 ---------- */
.rules {
  margin-top: var(--space-2xl);
  padding: 30rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.rules__title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

.rules__row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: 12rpx 0;
}

.rules__tag {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.rules__tag--bad {
  background: var(--coral-light);
  color: var(--coral);
}

.rules__tag--good {
  background: var(--grass-light);
  color: var(--grass);
}

.rules__text {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  line-height: 1.55;
}

/* ---------- 区块 ---------- */
.section {
  margin-top: var(--space-2xl);
}

.section__title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

/* ---------- 加油包 ---------- */
.packs {
  display: flex;
  gap: var(--space-md);
}

.pack {
  position: relative;
  flex: 1;
  padding: 30rpx 18rpx 26rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  border: 3rpx solid transparent;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.pack--hover {
  opacity: 0.85;
}

.pack--active {
  border-color: var(--brand);
  background: var(--brand-light);
}

.pack__flag {
  position: absolute;
  top: -18rpx;
  height: 36rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--coral);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.pack__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.pack__price {
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--brand-deep);
  line-height: 1;
}

.pack__symbol {
  font-size: 26rpx;
  margin-right: 2rpx;
}

.pack__unit {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.pack__desc {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.4;
}

.buy {
  margin-top: var(--space-xl);
  height: 104rpx;
  border-radius: var(--radius-pill);
  background: var(--brand);
  color: var(--text-on-brand);
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.buy--active {
  opacity: 0.86;
}

.buy__hint {
  margin-top: var(--space-sm);
  font-size: var(--fs-tiny);
  color: var(--text-quaternary);
  text-align: center;
}

/* ---------- 流水 ---------- */
.logs {
  padding: 6rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.log {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.log:last-child {
  border-bottom: none;
}

.log__main {
  flex: 1;
  min-width: 0;
}

.log__source {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.log__remark {
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log__right {
  text-align: right;
  flex-shrink: 0;
}

.log__change {
  font-size: 32rpx;
  font-weight: 700;
}

.log__change--up { color: var(--grass); }
.log__change--down { color: var(--coral); }

.log__time {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-quaternary);
}

.logs-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}
