/* ============ 我的 —— 设计稿 09 / 17 ============ */

/* ---------- 用户卡 ---------- */
.profile {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  padding: 30rpx 28rpx;
  border-radius: var(--radius-2xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  margin-top: var(--space-sm);
}

.profile__avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile__avatar-img {
  width: 100%;
  height: 100%;
}

.profile__avatar-ph {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-deep);
}

.profile__main {
  flex: 1;
  min-width: 0;
}

.profile__name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile__meta {
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}

/* ---------- 数据概览 ---------- */
.stats {
  display: flex;
  align-items: center;
  margin-top: var(--space-lg);
  padding: 28rpx 0;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.stats__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats__num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.stats__label {
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}

.stats__line {
  width: 1rpx;
  height: 48rpx;
  background: var(--divider);
}

/* ---------- 分组 ---------- */
.group {
  margin-top: var(--space-2xl);
}

.group__title {
  font-size: var(--fs-caption);
  font-weight: 700;
  color: var(--text-tertiary);
  margin-bottom: var(--space-sm);
  padding-left: 8rpx;
}

.group__card {
  padding: 6rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

/* 去掉最后一个 list-item 的分隔线 */
.group__card :last-child .li--divider::after {
  display: none;
}

/* ---------- 深色模式行 ---------- */
.theme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
}

.theme-row__main {
  flex: 1;
  display: flex;
  align-items: center;
}

.theme-row__text {
  flex: 1;
}

.theme-row__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.theme-row__desc {
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}

/* ---------- 退出 ---------- */
.logout {
  margin-top: var(--space-2xl);
  height: 104rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  color: var(--coral);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}

.logout--active {
  opacity: 0.8;
}

.version {
  margin-top: var(--space-xl);
  font-size: var(--fs-tiny);
  color: var(--text-quaternary);
  text-align: center;
}
