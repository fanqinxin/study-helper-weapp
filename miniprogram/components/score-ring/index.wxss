.ring {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ring__svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.ring__center {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring__value {
  font-weight: 700;
  line-height: 1;
  font-size: 64rpx;
}

.ring__sub {
  margin-top: 8rpx;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}
