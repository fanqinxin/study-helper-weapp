.nav {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav--bordered {
  border-bottom: 1rpx solid var(--border-light);
}

/* 状态栏占位：只占高度，不渲染任何内容（系统状态栏已显示时间） */
.nav__status {
  width: 100%;
  flex-shrink: 0;
}

/* 标题栏 */
.nav__bar {
  display: flex;
  align-items: center;
  padding: 0 var(--space-xl);
  position: relative;
  box-sizing: border-box;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg-card);
  border: 1rpx solid var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
}

.nav__back--active {
  opacity: 0.6;
  transform: scale(0.94);
}

/* 返回箭头（纯 CSS 绘制，避免图片资源） */
.nav__arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav__title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-left: var(--space-md);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav__right {
  margin-left: var(--space-sm);
  flex-shrink: 0;
}
