.nav {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav--bordered {
  border-bottom: 1rpx solid var(--border-light);
}

/* 状态栏 */
.nav__status {
  display: flex;
  align-items: center;
  padding: 0 var(--space-xl);
  box-sizing: border-box;
}

.nav__time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 标题栏 */
.nav__bar {
  display: flex;
  align-items: center;
  padding: 0 var(--space-xl);
  position: relative;
  box-sizing: border-box;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-soft);
  flex-shrink: 0;
}

.nav__back--active {
  opacity: 0.7;
}

/* 返回箭头（纯 CSS 绘制，避免图片资源） */
.nav__arrow {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav__title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-left: var(--space-md);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav__right {
  margin-left: auto;
  flex-shrink: 0;
}
