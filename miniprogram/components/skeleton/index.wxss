.sk {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.sk__hero {
  height: 320rpx;
  border-radius: var(--radius-2xl);
  background: var(--progress-track);
  animation: sk-pulse 1.4s ease-in-out infinite;
}

.sk__row {
  height: 180rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-subtle);
  border: 1rpx solid var(--border-light);
  animation: sk-pulse 1.4s ease-in-out infinite;
}

.sk__row:nth-child(2) { animation-delay: 0.1s; }
.sk__row:nth-child(3) { animation-delay: 0.2s; }
.sk__row:nth-child(4) { animation-delay: 0.3s; }

@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
