{
  "name": "study-helper-server",
  "version": "1.0.0",
  "description": "小学生同步学习小程序 · 后端服务",
  "type": "commonjs",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "worker": "node src/jobs/homeworkWorker.js",
    "migrate": "node src/models/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:check": "node scripts/seed.js --dry-run",
    "check": "node scripts/check-requires.js",
    "docker:up": "docker compose up -d --build",
    "docker:migrate": "docker compose --profile tools run --rm migrate",
    "docker:seed": "docker compose --profile tools run --rm seed",
    "docker:logs": "docker compose logs -f api",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.4",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
