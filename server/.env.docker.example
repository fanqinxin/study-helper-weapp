# ============================================================
# Docker 部署环境变量
#
# 用法：复制到项目根目录并改名为 .env
#   cp server/.env.example .env
# 然后按下面标注修改【部署必改】的项。
#
# 注意：DB_HOST / REDIS_HOST 在 compose 里已被服务名覆盖，
# 这里保持 127.0.0.1 即可，本地直接跑 node 时也能用。
# ============================================================

# ============ 服务 ============
PORT=3000
NODE_ENV=production

# ============ 镜像来源 ============
# 留空 = 用本地构建的 study-helper-server:latest（首次 docker compose up --build）
# 服务器部署 = 指向 CI 推送到私有仓库的镜像，直接拉取不本地构建
# IMAGE_TAG=registry.cn-shenzhen.aliyuncs.com/fanqx/study-helper-server:latest

# ============ 微信小程序【部署必改】============
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# ============ 数据库 ============
# DB_ROOT_PASSWORD：仅 MySQL 容器 root 用，不对外
# DB_PASSWORD：应用账号密码，compose 会自动创建该账号
DB_ROOT_PASSWORD=change_this_root_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=study_helper
DB_USER=study
DB_PASSWORD=change_this_db_password

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ JWT【部署必改，生产强制校验】============
# 生成：openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# ============ AI 模型【部署必改】============
# 可配置：qwen | hunyuan | openaiCompat
# 识别模型必须是百炼当前「视觉理解」推荐模型；qwen-vl-max 中国内地已不可用
#   省钱可换 qwen3.8-flash；试卷/手写 OCR 重度场景可评估 qwen3.5-ocr
AI_PROVIDER=qwen
AI_VISION_MODEL=qwen3.7-plus
AI_TEXT_MODEL=qwen-plus
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MAX_RETRY=2
AI_TIMEOUT_MS=60000

# ============ 额度策略 ============
# 【内测期】个人主体无法开通微信支付，页面不提供任何购买入口，
# 因此这里要一次给足，否则用户会卡在「额度不足」且无路可走。
# 500 次/周 ≈ 每天 70 次批改，家庭正常使用碰不到上限。
# 正式上线并接入支付后再调回 20 左右。
QUOTA_FREE_TOTAL=500
QUOTA_CYCLE_DAYS=7
QUOTA_WARN_THRESHOLD=10

# ============ 反向代理 ============
# 走 Nginx 时保持默认（信任 1 跳）即可，用于把 X-Forwarded-For 还原成真实客户端 IP。
# login 限流以 req.ip 为键，不开这个会导致全站用户共用一个登录额度。
# 若链路是 CDN → Nginx → 应用，把跳数调大（如 2）。
# TRUST_PROXY=1

# ============ 微信支付（Phase 4 启用）============
WXPAY_MCHID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=https://your-domain.com/api/v1/order/notify

# ============ 对象存储 ============
# 留空则使用容器内 /app/uploads（已挂卷持久化）
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_CDN_DOMAIN=

# ============ 上传限制 ============
UPLOAD_MAX_SIZE_MB=3

# ============ 日志 ============
LOG_LEVEL=info
