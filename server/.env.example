# ============ 服务 ============
PORT=3000
NODE_ENV=development

# ============ 微信小程序 ============
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# ============ 数据库 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=study_helper
DB_USER=root
DB_PASSWORD=your_password

# ============ Redis（额度计数 / 队列 / 幂等）============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ JWT ============
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# ============ AI 模型（可配置：qwen | hunyuan | openai）============
AI_PROVIDER=qwen

# 识别模型与判题模型可分开指定，便于成本控制
AI_VISION_MODEL=qwen-vl-max
AI_TEXT_MODEL=qwen-plus

AI_API_KEY=your_api_key_here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

AI_MAX_RETRY=2
AI_TIMEOUT_MS=60000

# ============ 额度策略 ============
# 免费额度：每周期次数与周期长度（天）。7 = 每周一重置
QUOTA_FREE_TOTAL=20
QUOTA_CYCLE_DAYS=7
# 剩余多少提示用户额度紧张
QUOTA_WARN_THRESHOLD=3

# ============ 微信支付（Phase 4 启用）============
WXPAY_MCHID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=https://your-domain.com/api/v1/order/notify

# ============ 对象存储 ============
# 留空则使用服务端本地存储（server/uploads），适合开发与早期上线
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_CDN_DOMAIN=

# ============ 上传限制 ============
# 单张图片大小上限（MB）。前端已压缩到 1MB，这里留余量
UPLOAD_MAX_SIZE_MB=3

# ============ 日志 ============
LOG_LEVEL=info
